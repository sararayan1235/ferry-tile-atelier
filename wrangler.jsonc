{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers (free plan) deployment of the Next.js app via @opennextjs/cloudflare.
  "name": "sr-fine-tile-atelier",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "sr-fine-tile-atelier" }
  ],
  "observability": { "enabled": true }
  // Secrets (set once with `npx wrangler secret put <NAME>`): SUPABASE_SERVICE_ROLE_KEY
}
